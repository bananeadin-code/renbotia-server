# ─────────────────────────────────────────────────────────────
# RenBotIA — variables de entorno del servidor (EJEMPLO)
# Copia este archivo a .env y complétalo. NUNCA subas tu .env real.
# ─────────────────────────────────────────────────────────────

# Entorno y servidor
NODE_ENV=development
# PORT lo asigna el hosting (Render). En local usa 5000. No lo fijes en producción.
# PORT=5000
CLIENT_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5173

# Base de datos (MongoDB Atlas en producción)
MONGODB_URI=mongodb://localhost:27017/renbotia

# JWT (genera cadenas largas y aleatorias, distintas entre sí)
JWT_ACCESS_SECRET=cambia-esto-por-una-cadena-larga-aleatoria
JWT_REFRESH_SECRET=cambia-esto-por-otra-cadena-larga-aleatoria
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Anthropic (Claude) — el cerebro del bot
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# Stripe (usa claves test en desarrollo, live en producción)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Inicio de sesión con Google (Client ID OAuth 2.0 tipo Web; no es secreto)
GOOGLE_CLIENT_ID=

# Emails transaccionales (Resend)
RESEND_API_KEY=
EMAIL_FROM=RenBotIA <onboarding@resend.dev>
EMAIL_REPLY_TO=

# ── WhatsApp Cloud API (Meta) ──
# WHATSAPP_TOKEN:          token de acceso (permanente/sistema) para la Graph API.
# WHATSAPP_VERIFY_TOKEN:   cadena que TÚ inventas; Meta la usa para verificar el webhook.
# WHATSAPP_APP_SECRET:     "App Secret" de tu app de Meta; valida la firma del webhook.
# WHATSAPP_API_VERSION:    versión de la Graph API (ej. v21.0).
# WHATSAPP_PHONE_NUMBER_ID: id del número por defecto (opcional; cada negocio guarda el suyo).
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
